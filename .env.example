# Web3Forms (https://web3forms.com)
# Free plan: must be client-side — use NEXT_PUBLIC_ keys.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
NEXT_PUBLIC_WEB3FORMS_NEWSLETTER_ACCESS_KEY=
NEXT_PUBLIC_WEB3FORMS_ADDONS_ACCESS_KEY=

# Add all three in Vercel → Settings → Environment Variables, then redeploy.
# Submissions appear in your email inbox and the Web3Forms dashboard.
