# Web3Forms (https://web3forms.com)
# Free plan: must be client-side — use NEXT_PUBLIC_ keys.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
NEXT_PUBLIC_WEB3FORMS_NEWSLETTER_ACCESS_KEY=
NEXT_PUBLIC_WEB3FORMS_ADDONS_ACCESS_KEY=

# Add all three in Vercel → Settings → Environment Variables, then redeploy.
# Submissions appear in your email inbox and the Web3Forms dashboard.

# --- Supabase (product admin at /admin-product) -------------------------------
# Both are safe to expose: the publishable/anon key is designed to be public and Row
# Level Security is what protects the data. The service-role / secret key must NEVER
# appear here or anywhere in the repo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
